{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "runtime": "vercel-python-runtimes@6.2.0"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/((?!api/|static/|_next/|favicon\\.ico).*)", "destination": "/api/index.py" }
  ],
  "trailingSlash": false
}
