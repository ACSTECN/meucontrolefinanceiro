{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pip install -r requirements.txt",
  "functions": {
    "api/index.py": {
      "includeFiles": "app/**,templates/**,static/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.py" }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}

